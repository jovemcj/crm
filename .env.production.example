# Estas variáveis devem ser configuradas no painel da Railway

# Gerado automaticamente pela Railway ao adicionar PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_secreta_aqui

# Ambiente
NODE_ENV=production

# Porta (Railway define automaticamente, não precisa setar)
# PORT=3333
